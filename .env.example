# ============================================================
# H&M Personalized Recommendation System — environment config
# Copy to `.env` and adjust. All values have working defaults
# for local development.
# ============================================================

# --- Data locations (relative paths resolve from the project root) ---
DATA_DIR=./parquet
SERVING_DATA_DIR=./serving_data
RECOMMENDATIONS_DIR=./recommendations
MODELS_DIR=./models

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins ("" = allow localhost dev origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Images ---
# The source dataset contains NO product images and no public H&M CDN URL
# pattern is available. Three legitimate options, in order of precedence:
#
# 1) LOCAL IMAGE DIRECTORY: point IMAGE_DIR at the H&M images folder
#    (read-only, NOT copied into the project). Structure: 3-digit prefix
#    subfolders with 10-digit article-id filenames:
#        <IMAGE_DIR>/080/0800691008.jpg
#    Then build the lightweight index once:
#        python scripts/build_image_index.py
#    Example (Kaggle download):
# IMAGE_DIR=D:/Dataset/h-and-m-personalized-fashion-recommendations/images
#
# 2) URL TEMPLATE: any real image host you control.
#    {article_id}    -> canonical 10-digit form  (0800691008)
#    {article_id_raw} -> bare numeric form       (800691008)
# IMAGE_URL_TEMPLATE=https://cdn.example.com/hm/images/{article_id}.jpg
#
# 3) Neither set -> the app renders deterministic editorial placeholders.
# Backend port used by the frontend dev proxy
VITE_API_BASE_URL=/api
